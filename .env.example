# CriticAI — Environment Variable Template
# Copy this file to .env and fill in your real keys.
# ALL listed APIs are FREE — no credit card required.

# ─── Groq (Free — console.groq.com) ──────────────────────────────────────────
# Sign up at https://console.groq.com → API Keys → Create key
GROQ_API_KEY=your_groq_api_key_here

# ─── Google Gemini (Free 1500 req/day — aistudio.google.com) ─────────────────
# Get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Ollama (Local — no internet needed) ─────────────────────────────────────
# Download at https://ollama.com → run: ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# ─── Default Provider ─────────────────────────────────────────────────────────
# Options: groq | gemini | ollama | simulation
DEFAULT_PROVIDER=groq

# ─── CriticAI Config ──────────────────────────────────────────────────────────
# Set to "true" to force simulation mode (no API calls) for testing
CRITICAI_SIMULATION=false

# Default model for evaluations
CRITICAI_MODEL=llama-3.1-70b-versatile

# ─── Slack & Discord Alerts (Free — no credit card) ───────────────────────────
# Slack: https://api.slack.com/messaging/webhooks → Create App → Incoming Webhooks
# Discord: Server Settings → Integrations → Webhooks → New Webhook
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Alert fires when health score drops below this value (0-100, default 50)
ALERT_THRESHOLD=50

# ─── Docker / ChromaDB Settings ───────────────────────────────────────────────
# These are set automatically by docker-compose.yml — only change if self-hosting
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_USE_HTTP=false
