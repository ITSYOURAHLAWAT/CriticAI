# CriticAI Environment Variables
# Copy this file to .env and fill in your values

# ─── LLM Provider API Keys (all FREE, no credit card) ─────────────────────────

# Groq — https://console.groq.com  (free, no card, 14,400 req/day)
GROQ_API_KEY=your_groq_key_here

# Gemini — https://aistudio.google.com  (free tier, 1,500 req/day)
GEMINI_API_KEY=your_gemini_key_here

# Ollama (optional, local only) — https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434

# Default LLM provider to use (groq | gemini | ollama)
DEFAULT_PROVIDER=groq

# Environment (development | production)
ENVIRONMENT=development

